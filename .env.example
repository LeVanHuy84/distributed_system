# ============================================================
# FlashOrder (Phase 2) - Environment Variables Example
# Copy file này thành ".env" nếu muốn override cấu hình mặc định:
#   cp .env.example .env
# Lưu ý: KHÔNG commit file ".env" lên Git.
# ============================================================

# ------------------------------------------------------------
# 1. PostgreSQL 16 (Admin / Container Init)
# ------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_BENCH_PORT=5433
POSTGRES_DB=flashorder_db
POSTGRES_USER=flashorder
POSTGRES_PASSWORD=flashorder_password

# ------------------------------------------------------------
# 2. Isolated Service Databases (Database-per-Service)
# Khớp với docker/postgres/init-databases.sql
# ------------------------------------------------------------
ORDER_DB_NAME=order_db
ORDER_DB_USER=order_user
ORDER_DB_PASSWORD=order_password

INVENTORY_DB_NAME=inventory_db
INVENTORY_DB_USER=inventory_user
INVENTORY_DB_PASSWORD=inventory_password

PAYMENT_DB_NAME=payment_db
PAYMENT_DB_USER=payment_user
PAYMENT_DB_PASSWORD=payment_password

# ------------------------------------------------------------
# 3. Redis 7
# ------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_BENCH_PORT=6380

# ------------------------------------------------------------
# 4. Apache Kafka (KRaft)
# ------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_BENCH_BOOTSTRAP_SERVERS=localhost:9094

# ------------------------------------------------------------
# 5. Microservices Ports & JVM Runtime
# ------------------------------------------------------------
ORDER_SERVICE_PORT=8080
INVENTORY_SERVICE_PORT=8081
PAYMENT_SERVICE_PORT=8082
SPRING_THREADS_VIRTUAL_ENABLED=true

# ------------------------------------------------------------
# 6. Observability (Docker profile: observability)
# ------------------------------------------------------------
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
JAEGER_UI_PORT=16686
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318
TRACING_SAMPLING_PROBABILITY=1.0

# ------------------------------------------------------------
# 7. Worker & Mock Payment Tuning
# ------------------------------------------------------------
INVENTORY_RELEASE_INTERVAL_MS=5000
PAYMENT_MOCK_DELAY_MS=0
PAYMENT_MOCK_FAILURE_RATE=0.0
